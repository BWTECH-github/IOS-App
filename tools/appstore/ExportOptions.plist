<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App-Store-Export fuer owncloud.online (BW-TECH GmbH) -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>A7VZ8HFNR4</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- "export" schreibt nur das IPA; release.sh setzt "upload" ausschliesslich mit dem Schalter --upload -->
	<key>destination</key>
	<string>export</string>
	<!-- Build-Nummer kommt aus release.sh (--build), Xcode soll sie nicht selbst hochzaehlen -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
